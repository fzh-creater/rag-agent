# 复制本文件为 .env（同目录），填入你的配置即可长期生效。
# .env 已被 .gitignore 排除，不会被提交；程序启动时自动加载，已设置的环境变量优先。

# ============ 方案 A：云端 API（推荐，不用下载模型）============
# 以 DeepSeek 为例；换服务商只改这三个值。
RAG_LLM_API_KEY=sk-327e043c90b94e8683a55d3d0731fc51
# RAG_LLM_BASE_URL=https://api.deepseek.com/v1
# RAG_CHAT_MODEL=deepseek-chat

# 其它常见服务商（取消注释并保留其中一组）：
# 通义千问（DashScope 兼容模式）
# RAG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG_CHAT_MODEL=qwen-plus
#
# 硅基流动 SiliconFlow
# RAG_LLM_BASE_URL=https://api.siliconflow.cn/v1
# RAG_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# OpenAI
# RAG_LLM_BASE_URL=https://api.openai.com/v1
# RAG_CHAT_MODEL=gpt-4o-mini

# ============ 方案 B：本地 Ollama ============
# RAG_LLM_PROVIDER=ollama
# RAG_OLLAMA_BASE_URL=http://localhost:11434/v1
# RAG_CHAT_MODEL=qwen2.5:7b

# ============ 检索与切分（一般不用改）============
# RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# RAG_MAX_CONTEXT_CHUNKS=5
# RAG_LLM_TIMEOUT=180
